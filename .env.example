# ============================================================
# CineSuggest AI — Environment Variables Reference
# ============================================================
# Copy this file to:
#   - backend/.env       (backend secrets)
#   - .env.local         (frontend VITE_ variables)
#
# NEVER commit real values to Git. This file documents keys only.
# ============================================================

# ── FRONTEND (Vite) ──────────────────────────────────────────
# Base URL of your deployed backend
VITE_API_URL=https://your-backend.vercel.app

# ── BACKEND DATABASE ─────────────────────────────────────────
# Supabase Postgres connection string
# Use port 5432 for session pooler / direct connection
# Use port 6543 for transaction pooler (serverless / Vercel)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ──────────────────────────────────────────────────────
# Strong random secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-long-random-secret-here

# ── TMDB API ─────────────────────────────────────────────────
# Get your key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_bearer_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── EMAIL / RESEND ───────────────────────────────────────────
# Get your API key at https://resend.com
# Requires a verified domain to send from a custom address.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address (must match a verified Resend domain)
EMAIL_FROM=CineSuggest <noreply@yourdomain.com>

# ── OTP SETTINGS ─────────────────────────────────────────────
# How many minutes an OTP is valid (default: 15)
OTP_EXPIRY_MINUTES=15

# ── DEPLOYMENT ───────────────────────────────────────────────
# Set to 1 to create DB tables on startup (local dev only)
CREATE_TABLES=0
# Set to 1 to force NullPool (required on Vercel / serverless)
DB_NULLPOOL=0
# Explicit frontend URL added to CORS allow-list
FRONTEND_URL=https://your-frontend.vercel.app
